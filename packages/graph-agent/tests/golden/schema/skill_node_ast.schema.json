{
  "$defs": {
    "SubagentSpec": {
      "additionalProperties": false,
      "description": "Sub-skill declared as a callable tool on a SKILL phase.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "target_skill": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Skill"
        },
        "path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "SubagentSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "LLM ReAct phase node parsed from ``SKILL.md``.",
  "properties": {
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "raw_blocks": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Raw Blocks",
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "mode": {
      "const": "skill",
      "title": "Mode",
      "type": "string"
    },
    "system_prompt": {
      "minLength": 1,
      "title": "System Prompt",
      "type": "string"
    },
    "exit_contract": {
      "minLength": 1,
      "title": "Exit Contract",
      "type": "string"
    },
    "tools": {
      "items": {
        "type": "string"
      },
      "title": "Tools",
      "type": "array"
    },
    "subagents": {
      "items": {
        "$ref": "#/$defs/SubagentSpec"
      },
      "title": "Subagents",
      "type": "array"
    }
  },
  "required": [
    "mode",
    "system_prompt",
    "exit_contract"
  ],
  "title": "SkillNodeAST",
  "type": "object"
}
