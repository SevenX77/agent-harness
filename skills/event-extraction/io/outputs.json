{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_timeline": {
      "type": "object",
      "properties": {
        "chapter_number": {"type": "integer"},
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {"type": "string"},
              "title": {"type": "string"},
              "type": {"type": "string"},
              "paragraph_indices": {
                "type": "array",
                "items": {"type": "integer"}
              },
              "summary": {"type": "string"},
              "location": {"type": "string"},
              "time": {"type": "string"}
            },
            "required": ["event_id", "title", "type", "paragraph_indices", "summary"]
          }
        },
        "settings": {"type": "array"},
        "metadata": {"type": "object"}
      },
      "required": ["chapter_number", "events"]
    }
  },
  "required": ["event_timeline"],
  "additionalProperties": true
}
