{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "producer_review": {
      "type": "object",
      "properties": {
        "passed": {"type": "boolean"},
        "score": {"type": "integer", "minimum": 1, "maximum": 10},
        "verdict": {"type": "string"},
        "reasons": {
          "type": "array",
          "items": {"type": "string"}
        },
        "suggestions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "critic_metadata": {"type": "object"}
      },
      "required": ["passed", "score", "verdict", "reasons", "suggestions"],
      "additionalProperties": true
    }
  },
  "required": ["producer_review"],
  "additionalProperties": true
}
