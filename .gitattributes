# Cross-platform baseline (docs/development/CROSS_PLATFORM.md):
# all text is stored AND checked out as LF, regardless of any local
# core.autocrlf setting. Platform-specific exceptions are explicit below.
* text=auto eol=lf

# Windows-native script formats keep CRLF in the working tree.
# (.bat/.cmd genuinely require CRLF; .ps1 kept CRLF for legacy
# Windows PowerShell 5.1 friendliness.)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never subject to text/EOL conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
