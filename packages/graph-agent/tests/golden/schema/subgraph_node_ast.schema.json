{
  "$defs": {
    "PhaseIOSchema": {
      "additionalProperties": false,
      "description": "Inline JSON Schema contract for a graph or phase boundary.",
      "properties": {
        "inputs": {
          "additionalProperties": true,
          "minProperties": 1,
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": true,
          "minProperties": 1,
          "title": "Outputs",
          "type": "object"
        }
      },
      "required": [
        "inputs",
        "outputs"
      ],
      "title": "PhaseIOSchema",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Subgraph delegation phase node parsed from ``SUBGRAPH.md``.",
  "properties": {
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "raw_blocks": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Raw Blocks",
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "mode": {
      "const": "subgraph",
      "title": "Mode",
      "type": "string"
    },
    "sub_skill_ref": {
      "minLength": 1,
      "title": "Sub Skill Ref",
      "type": "string"
    },
    "target_skill": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Skill"
    },
    "io": {
      "anyOf": [
        {
          "$ref": "#/$defs/PhaseIOSchema"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "validator": {
      "default": false,
      "title": "Validator",
      "type": "boolean"
    }
  },
  "required": [
    "mode",
    "sub_skill_ref"
  ],
  "title": "SubgraphNodeAST",
  "type": "object"
}
