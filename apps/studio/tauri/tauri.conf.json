{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skill Studio",
  "version": "0.1.0",
  "identifier": "com.sevenx.skill-studio",
  "build": {
    "beforeDevCommand": "node tauri/scripts/sync_resources.js && node tauri/scripts/ensure_vendor.js && node tauri/scripts/dev_frontend.js",
    "beforeBuildCommand": "cd frontend && npm run build && cd .. && node tauri/scripts/download_runtime.js && python3 backend/scripts/build_vendor.py && node tauri/scripts/sync_resources.js",
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Skill Studio",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "vendor/**/*",
      "python_runtime/**/*",
      "../../../config/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
