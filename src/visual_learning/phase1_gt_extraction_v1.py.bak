"""
Learning Flow Phase 1: GT数据提取

职责：
- 从GT成片视频中提取画面描述
- 使用视频理解模型（Seed 1.8 或 Gemini 3.1 Pro）
- 输出结构化的GT画面描述和视觉元素

设计文档：docs/design/learning/visual_learning.md
"""

import asyncio
import json
import logging
from pathlib import Path
from typing import List, Dict, Any, Optional
from datetime import datetime
from pydantic import BaseModel, Field
from enum import Enum

from src.core.config import AppConfig, config
from src.core.exceptions import FileOperationError, WorkflowError
from src.core.multimodal_client_manager import (
    MultimodalClientManager,
    VideoUnderstandingService
)

# 导入EDL解析器和自动生成器
from .edl_parser import EDLParser, EDLShot, edl_to_simple_dict
from .auto_edl_generator import AutoEDLGenerator

logger = logging.getLogger(__name__)


# ============================================================
# 数据模型（Schema）
# ============================================================

class GTSegmentDescription(BaseModel):
    """单个GT片段的画面描述"""
    segment_id: str
    time_range: List[float]  # [start, end]
    
    description: Dict[str, Any]  # 包含main_subject, actions, environment等


class GTSceneDescription(BaseModel):
    """GT成片视频的完整画面描述"""
    version: str = "1.0"
    video_path: str
    total_duration: float
    total_segments: int
    
    extracted_at: str
    video_understanding_service: str
    
    segments: List[GTSegmentDescription]


class GTVisualElement(BaseModel):
    """GT中提取的视觉元素"""
    element_type: str  # "character" | "prop" | "scene"
    element_id: str
    appearance_in_gt: Dict[str, Any]
    time_ranges: List[List[float]]  # 出现的时间段


class GTVisualElements(BaseModel):
    """GT视觉元素集合"""
    version: str = "1.0"
    video_path: str
    extracted_at: str
    
    characters: List[GTVisualElement]
    props: List[GTVisualElement]
    scenes: List[GTVisualElement]


# ============================================================
# Phase 1 Agent
# ============================================================

class Phase1GTExtractionAgent:
    """
    Phase 1: GT数据提取 Agent
    
    执行流程：
    1. 自动生成EDL（如果未提供）或使用已有EDL
    2. 基于EDL精确镜头切点提取画面描述
    3. 对每个镜头调用视频理解模型
    4. 提取结构化的视觉元素
    """
    
    def __init__(
        self,
        gt_video_path: str,
        project_name: str,
        config: AppConfig,
        edl_path: Optional[str] = None,  # ⭐ 可选：EDL文件路径（如果不提供则自动生成）
        video_service: VideoUnderstandingService = VideoUnderstandingService.SEED18,
        fps: int = 30,  # EDL帧率
        # 自动EDL生成参数（仅在edl_path为None时使用）
        auto_edl_threshold: int = 22,
        auto_edl_min_shot_duration: float = 0.5
    ):
        self.gt_video_path = Path(gt_video_path)
        self.project_name = project_name
        self.config = config
        self.video_service = video_service
        self.fps = fps
        self.auto_edl_threshold = auto_edl_threshold
        self.auto_edl_min_shot_duration = auto_edl_min_shot_duration
        
        # 验证GT视频存在
        if not self.gt_video_path.exists():
            raise FileOperationError(
                message=f"GT视频不存在: {gt_video_path}",
                file_path=str(gt_video_path),
                operation="validate_input"
            )
        
        # EDL处理：使用已有或自动生成
        if edl_path:
            self.edl_path = Path(edl_path)
            if not self.edl_path.exists():
                raise FileOperationError(
                    message=f"EDL文件不存在: {edl_path}",
                    file_path=str(edl_path),
                    operation="validate_input"
                )
            self.auto_generate_edl = False
            logger.info(
                f"[Phase1Agent] 初始化，project={project_name}, "
                f"video={self.gt_video_path.name}, edl={self.edl_path.name}, service={video_service.value}"
            )
        else:
            # 自动生成EDL的输出路径
            self.edl_path = Path("outputs") / project_name / "learning" / "phase1_gt_extraction" / f"{self.gt_video_path.stem}_auto.edl"
            self.auto_generate_edl = True
            logger.info(
                f"[Phase1Agent] 初始化（自动EDL模式），project={project_name}, "
                f"video={self.gt_video_path.name}, service={video_service.value}"
            )
    
    async def execute(self) -> Dict[str, Any]:
        """主执行流程"""
        logger.info(f"[Phase1Agent] 开始GT数据提取: {self.gt_video_path.name}")
        
        try:
            # Step 0: 自动生成EDL（如果需要）
            if self.auto_generate_edl:
                self._generate_edl()
            
            # Step 1: 解析EDL文件
            edl_shots = self._parse_edl()
            logger.info(f"[Phase1Agent] EDL解析完成: {len(edl_shots)}个镜头")
            
            # Step 2: 基于EDL镜头提取画面描述
            gt_scene_description = await self._extract_scene_descriptions(edl_shots)
            
            # Step 3: 提取视觉元素
            gt_visual_elements = await self._extract_visual_elements(gt_scene_description)
            
            # Step 4: 保存输出
            self._save_outputs(gt_scene_description, gt_visual_elements)
            
            logger.info(
                f"[Phase1Agent] 完成，提取了{len(gt_scene_description.segments)}个片段, "
                f"{len(gt_visual_elements.characters)}个角色, "
                f"{len(gt_visual_elements.props)}个道具, "
                f"{len(gt_visual_elements.scenes)}个场景"
            )
            
            return {
                "gt_scene_description": gt_scene_description.dict(),
                "gt_visual_elements": gt_visual_elements.dict()
            }
        
        except Exception as e:
            logger.error(f"[Phase1Agent] 执行失败: {e}", exc_info=True)
            raise WorkflowError(
                f"Phase 1 GT数据提取失败: {e}",
                details={"video": str(self.gt_video_path), "project": self.project_name}
            ) from e
    
    # ── Step 0: 自动生成EDL（如果需要）────────────────────────────────────
    
    def _generate_edl(self) -> None:
        """
        自动生成EDL文件
        
        使用PySceneDetect + 后处理，检测镜头切点
        """
        logger.info(f"[Phase1Agent] 开始自动生成EDL: {self.gt_video_path.name}")
        
        # 确保输出目录存在
        self.edl_path.parent.mkdir(parents=True, exist_ok=True)
        
        # 创建自动EDL生成器
        generator = AutoEDLGenerator(fps=self.fps, threshold=self.auto_edl_threshold)
        
        # 生成EDL
        generator.generate_edl(
            video_path=str(self.gt_video_path),
            output_edl_path=str(self.edl_path),
            min_scene_length=15,
            merge_short_scenes=True,
            min_shot_duration=self.auto_edl_min_shot_duration
        )
        
        logger.info(
            f"[Phase1Agent] ✅ EDL自动生成完成: {self.edl_path}"
            f" (参数: threshold={self.auto_edl_threshold}, min_shot_duration={self.auto_edl_min_shot_duration}s)"
        )
    
    # ── Step 1: 解析EDL ────────────────────────────────────
    
    def _parse_edl(self) -> List[EDLShot]:
        """解析EDL文件，获取精确的镜头切点"""
        parser = EDLParser(fps=self.fps)
        shots = parser.parse(str(self.edl_path))
        
        # 过滤过短的镜头（<1秒）
        shots = parser.filter_short_shots(shots, min_duration=1.0)
        
        total_duration = parser.get_total_duration(shots)
        avg_duration = sum(s.duration_seconds for s in shots) / len(shots)
        
        logger.info(f"[Phase1Agent] EDL统计: 总时长{total_duration:.2f}s, 平均{avg_duration:.2f}s/镜头")
        
        return shots
    
    # ── Step 2: 基于EDL提取画面描述 ────────────────────────────────────
    
    async def _extract_scene_descriptions(self, edl_shots: List[EDLShot]) -> GTSceneDescription:
        """
        基于EDL镜头切点提取GT画面描述
        
        策略：
        - 使用EDL的精确镜头边界
        - 对每个镜头调用视频理解模型
        - 提问：画面主体、动作、环境、镜头类型、情绪氛围
        """
        logger.info(f"[Phase1Agent] 开始提取画面描述，基于EDL {len(edl_shots)}个镜头")
        
        # 并发提取所有镜头（性能优化）
        tasks = []
        for shot in edl_shots:
            segment_id = f"gt_shot_{shot.shot_number:03d}"
            tasks.append(
                self._extract_single_shot(
                    segment_id,
                    shot.start_seconds,
                    shot.end_seconds,
                    shot.shot_number
                )
            )
        
        # 并发执行
        logger.info(f"[Phase1Agent] 并发提取{len(tasks)}个镜头...")
        segments = await asyncio.gather(*tasks)
        
        # 获取总时长
        total_duration = edl_shots[-1].end_seconds if edl_shots else 0.0
        
        return GTSceneDescription(
            video_path=str(self.gt_video_path),
            total_duration=total_duration,
            total_segments=len(segments),
            extracted_at=datetime.now().isoformat(),
            video_understanding_service=self.video_service.value,
            segments=segments
        )
    
    async def _extract_single_shot(
        self,
        segment_id: str,
        start_time: float,
        end_time: float,
        shot_number: int
    ) -> GTSegmentDescription:
        """
        提取单个镜头的画面描述（基于EDL镜头边界）
        
        注意：这是一个**完整的镜头**（从切点到切点），不是随意分段
        """
        duration = end_time - start_time
        logger.info(f"[{segment_id}] 提取镜头描述: Shot {shot_number}, {start_time:.2f}s - {end_time:.2f}s ({duration:.2f}s)")
        
        # 构建提问prompt
        prompt = self._build_segment_analysis_prompt(start_time, end_time, shot_number)
        
        # 调用视频理解模型
        try:
            result = await MultimodalClientManager.understand_video(
                service=self.video_service,
                video_source=str(self.gt_video_path),
                question=prompt,
                max_tokens=800
            )
            
            # 解析返回的JSON（LLM应该返回JSON格式）
            description = self._parse_video_understanding_result(result.answer)
            
            logger.info(f"[{segment_id}] ✅ 提取完成")
            
            return GTSegmentDescription(
                segment_id=segment_id,
                time_range=[start_time, end_time],
                description={
                    **description,
                    "shot_number": shot_number,  # 保留镜头编号
                    "duration": end_time - start_time
                }
            )
        
        except Exception as e:
            logger.error(f"[{segment_id}] 提取失败: {e}")
            # 返回空描述（而非失败整个流程）
            return GTSegmentDescription(
                segment_id=segment_id,
                time_range=[start_time, end_time],
                description={
                    "error": str(e),
                    "shot_number": shot_number,
                    "duration": end_time - start_time,
                    "main_subject": "提取失败",
                    "actions": [],
                    "environment": {}
                }
            )
    
    def _build_segment_analysis_prompt(self, start_time: float, end_time: float, shot_number: int) -> str:
        """构建镜头分析prompt"""
        duration = end_time - start_time
        return f"""
请分析这个视频的**镜头{shot_number}**（{start_time:.2f}秒 到 {end_time:.2f}秒，时长{duration:.2f}秒）。

注意：这是一个**完整的镜头**（从镜头切点到切点），不是随意切分的片段。

请以JSON格式回答以下问题：

1. main_subject: 画面的主体是什么？（人物/物体/场景）
   - 如果是人物：外观特征、服装、表情
   - 如果是物体：类型、特征、状态
   - 如果是场景：地点类型、环境特点

2. actions: 主体在做什么动作？（动词列表）
   - 例如: ["driving", "looking_around", "reaching"]

3. environment: 环境细节
   - location: 地点类型（室内/室外，具体场景）
   - details: 环境具体细节（至少3个）
   - atmosphere: 氛围感（形容词）

4. shot_type: 镜头类型
   - 选择: close_up | medium_shot | wide_shot | establishing_shot | following_shot
   - 镜头运动: static | pan | tilt | zoom | dolly | following

5. emotion: 这个画面传达的情绪
   - 情绪类型: tension | suspense | calm | joy | despair | hope
   - 情绪强度: 1-10

请严格按照JSON格式输出，不要有额外的文字说明。

示例格式:
{{
  "main_subject": "...",
  "actions": ["...", "..."],
  "environment": {{
    "location": "...",
    "details": ["...", "...", "..."],
    "atmosphere": "..."
  }},
  "shot_type": "medium_shot",
  "camera_movement": "following",
  "emotion": "tension",
  "emotion_intensity": 8
}}
"""
    
    def _parse_video_understanding_result(self, answer: str) -> Dict[str, Any]:
        """
        解析视频理解模型的返回结果
        
        期望格式：JSON
        容错：如果不是JSON，尝试提取或返回文本
        """
        try:
            # 尝试直接解析JSON
            return json.loads(answer)
        except json.JSONDecodeError:
            # 尝试提取JSON块（有些模型会在JSON前后加说明文字）
            import re
            json_match = re.search(r'\{.*\}', answer, re.DOTALL)
            if json_match:
                try:
                    return json.loads(json_match.group(0))
                except:
                    pass
            
            # 如果都失败，返回原始文本作为描述
            logger.warning(f"无法解析JSON，返回原始文本: {answer[:100]}...")
            return {
                "main_subject": answer[:200],
                "actions": [],
                "environment": {"details": []},
                "shot_type": "unknown",
                "camera_movement": "unknown",
                "emotion": "unknown"
            }
    
    # ── Step 3: 提取视觉元素 ────────────────────────────────────
    
    async def _extract_visual_elements(
        self,
        gt_scene_description: GTSceneDescription
    ) -> GTVisualElements:
        """
        从GT画面描述中提取结构化视觉元素
        
        策略：
        - 合并所有片段的描述
        - 识别人物、道具、场景
        - 统计出现时间和频率
        """
        logger.info(f"[Phase1Agent] 开始提取视觉元素")
        
        # 使用LLM进行元素提取和归类
        # 输入：所有片段的描述
        # 输出：结构化的元素列表
        
        # 构建prompt
        segments_text = self._format_segments_for_analysis(gt_scene_description.segments)
        
        prompt = f"""
你是视觉分析专家，从以下GT视频的画面描述中，提取并归类所有视觉元素。

**GT画面描述**（按时间顺序）:
{segments_text}

请以JSON格式输出，分为三类：

1. characters: 角色列表
   - character_id: 角色名称或描述
   - appearance_in_gt: 在GT中的外观特征
   - time_ranges: 出现的时间段（数组）

2. props: 道具/物品列表
   - prop_id: 道具名称
   - appearance_in_gt: 在GT中的外观特征
   - time_ranges: 出现的时间段

3. scenes: 场景列表
   - scene_id: 场景名称
   - appearance_in_gt: 在GT中的视觉特征
   - time_ranges: 出现的时间段

示例格式:
{{
  "characters": [
    {{
      "character_id": "男主角",
      "appearance_in_gt": {{
        "age": "30岁左右",
        "build": "结实",
        "facial_features": ["脸上有疤痕"],
        "clothing": ["军绿色外套"]
      }},
      "time_ranges": [[0, 120], [150, 180]]
    }}
  ],
  "props": [...],
  "scenes": [...]
}}
"""
        
        # 调用LLM
        from src.core.llm_client_manager import LLMClientManager
        
        result = await LLMClientManager.call(
            tier="alpha",  # 使用高质量模型
            messages=[{"role": "user", "content": prompt}],
            temperature=0.3,
            response_format="json"
        )
        
        # 解析结果
        elements_data = json.loads(result.content)
        
        # 构建GTVisualElements
        characters = [
            GTVisualElement(
                element_type="character",
                element_id=char["character_id"],
                appearance_in_gt=char["appearance_in_gt"],
                time_ranges=char["time_ranges"]
            )
            for char in elements_data.get("characters", [])
        ]
        
        props = [
            GTVisualElement(
                element_type="prop",
                element_id=prop["prop_id"],
                appearance_in_gt=prop["appearance_in_gt"],
                time_ranges=prop["time_ranges"]
            )
            for prop in elements_data.get("props", [])
        ]
        
        scenes = [
            GTVisualElement(
                element_type="scene",
                element_id=scene["scene_id"],
                appearance_in_gt=scene["appearance_in_gt"],
                time_ranges=scene["time_ranges"]
            )
            for scene in elements_data.get("scenes", [])
        ]
        
        logger.info(
            f"[Phase1Agent] ✅ 提取视觉元素：{len(characters)}个角色, "
            f"{len(props)}个道具, {len(scenes)}个场景"
        )
        
        return GTVisualElements(
            video_path=str(self.gt_video_path),
            extracted_at=datetime.now().isoformat(),
            characters=characters,
            props=props,
            scenes=scenes
        )
    
    def _format_segments_for_analysis(self, segments: List[GTSegmentDescription]) -> str:
        """格式化片段描述用于LLM分析"""
        formatted = []
        for seg in segments:
            formatted.append(
                f"[{seg.time_range[0]:.1f}s - {seg.time_range[1]:.1f}s] {seg.segment_id}:\n"
                f"{json.dumps(seg.description, ensure_ascii=False, indent=2)}"
            )
        return "\n\n".join(formatted)
    
    # ── Step 4: 保存输出 ────────────────────────────────────
    
    def _save_outputs(
        self,
        gt_scene_description: GTSceneDescription,
        gt_visual_elements: GTVisualElements
    ) -> None:
        """保存输出文件"""
        # 使用与Node Agent相同的输出路径结构
        output_dir = Path("outputs") / self.project_name / "learning" / "phase1_gt_extraction"
        output_dir.mkdir(parents=True, exist_ok=True)
        
        # 保存GT画面描述
        scene_desc_path = output_dir / "gt_scene_description.json"
        scene_desc_path.write_text(
            json.dumps(gt_scene_description.dict(), ensure_ascii=False, indent=2),
            encoding="utf-8"
        )
        logger.info(f"[Phase1Agent] ✅ 保存: {scene_desc_path}")
        
        # 保存GT视觉元素
        visual_elem_path = output_dir / "gt_visual_elements.json"
        visual_elem_path.write_text(
            json.dumps(gt_visual_elements.dict(), ensure_ascii=False, indent=2),
            encoding="utf-8"
        )
        logger.info(f"[Phase1Agent] ✅ 保存: {visual_elem_path}")


# ============================================================
# 辅助函数
# ============================================================

async def extract_gt_data(
    gt_video_path: str,
    project_name: str,
    config: Optional[AppConfig] = None,
    edl_path: Optional[str] = None  # 可选：如果不提供则自动生成
) -> Dict[str, Any]:
    """
    便捷函数：提取GT数据
    
    参数:
        gt_video_path: GT视频路径
        project_name: 项目名称
        config: 配置对象（可选）
        edl_path: EDL文件路径（可选，不提供则自动生成）
    """
    agent = Phase1GTExtractionAgent(
        gt_video_path=gt_video_path,
        project_name=project_name,
        config=config or AppConfig(),
        edl_path=edl_path
    )
    return await agent.execute()
