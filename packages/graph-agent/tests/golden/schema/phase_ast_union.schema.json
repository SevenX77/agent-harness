{
  "$defs": {
    "LogicNodeAST": {
      "additionalProperties": false,
      "description": "Deterministic Python phase node parsed from ``LOGIC.md``.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "raw_blocks": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Raw Blocks",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "mode": {
          "const": "logic",
          "title": "Mode",
          "type": "string"
        },
        "python_callable": {
          "minLength": 1,
          "title": "Python Callable",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "python_callable"
      ],
      "title": "LogicNodeAST",
      "type": "object"
    },
    "SkillNodeAST": {
      "additionalProperties": false,
      "description": "LLM ReAct phase node parsed from ``SKILL.md``.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "raw_blocks": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Raw Blocks",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "mode": {
          "const": "skill",
          "title": "Mode",
          "type": "string"
        },
        "system_prompt": {
          "minLength": 1,
          "title": "System Prompt",
          "type": "string"
        },
        "exit_contract": {
          "minLength": 1,
          "title": "Exit Contract",
          "type": "string"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        },
        "subagents": {
          "items": {
            "$ref": "#/$defs/SubagentSpec"
          },
          "title": "Subagents",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "system_prompt",
        "exit_contract"
      ],
      "title": "SkillNodeAST",
      "type": "object"
    },
    "SubagentSpec": {
      "additionalProperties": false,
      "description": "Sub-skill declared as a callable tool on a SKILL phase.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "description"
      ],
      "title": "SubagentSpec",
      "type": "object"
    },
    "SubgraphNodeAST": {
      "additionalProperties": false,
      "description": "Subgraph delegation phase node parsed from ``SUBGRAPH.md``.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "raw_blocks": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Raw Blocks",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "mode": {
          "const": "subgraph",
          "title": "Mode",
          "type": "string"
        },
        "sub_skill_ref": {
          "minLength": 1,
          "title": "Sub Skill Ref",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "sub_skill_ref"
      ],
      "title": "SubgraphNodeAST",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "logic": "#/$defs/LogicNodeAST",
      "skill": "#/$defs/SkillNodeAST",
      "subgraph": "#/$defs/SubgraphNodeAST"
    },
    "propertyName": "mode"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/LogicNodeAST"
    },
    {
      "$ref": "#/$defs/SubgraphNodeAST"
    },
    {
      "$ref": "#/$defs/SkillNodeAST"
    }
  ]
}
