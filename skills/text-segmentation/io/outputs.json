{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chapter_lines": {
      "type": "array",
      "items": {"type": "string"}
    },
    "chapter_with_line_numbers": {"type": "string"},
    "segmentation_result": {
      "type": "object",
      "properties": {
        "chapter_number": {"type": "integer"},
        "total_paragraphs": {"type": "integer"},
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {"type": "integer"},
              "type": {"type": "string", "enum": ["A", "B", "C"]},
              "content": {"type": "string"},
              "start_line": {"type": "integer"},
              "end_line": {"type": "integer"},
              "description": {"type": "string"}
            },
            "required": ["index", "type", "content", "start_line", "end_line"]
          }
        },
        "metadata": {"type": "object"}
      },
      "required": ["chapter_number", "total_paragraphs", "paragraphs"]
    }
  },
  "required": ["segmentation_result"],
  "additionalProperties": true
}
